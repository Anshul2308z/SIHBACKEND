# ==============================================================================
# SIH Backend Environment Configuration
# ==============================================================================

# LLM Provider Selection
# Set which model to use. Available options:
# "google"  (requires GEMINI_API_KEY)
# "openai"  (requires OPENAI_API_KEY)
# "groq"    (requires GROQ_API_KEY)
# "mistral" (requires MISTRAL_API_KEY)
ACTIVE_LLM="groq"

# API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
MISTRAL_API_KEY=""

# Relational Database Configuration
# Default is local SQLite. To use PostgreSQL, replace the URL:
# POSTGRES_URL="postgresql://user:password@localhost:5432/sihdb"
POSTGRES_URL="sqlite:///./sih_application.db"
